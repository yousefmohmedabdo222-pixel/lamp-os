#!/bin/bash
# LAMP OS - Desktop Application Menu
# Windows 7 Start Menu Style

# Colors for Windows 7 theme
BLUE='\033[0;34m'
LIGHT_BLUE='\033[1;34m'
GRAY='\033[0;37m'
WHITE='\033[1;37m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# Clear screen and display logo
clear

# Display LAMP OS Logo with Windows 7 theme
cat << 'LOGO'

╔════════════════════════════════════════════════════════════╗
║                                                            ║
║      🕯️  LAMP OS - Desktop Environment v2.0 🕯️             ║
║                                                            ║
║   ██╗     ██╗    ███╗   ███╗██████╗                       ║
║   ██║     ██║    ████╗ ████║██╔══██╗                      ║
║   ██║     ██║    ██╔████╔██║██████╔╝                      ║
║   ██║     ██║    ██║╚██╔╝██║██╔═══╝                       ║
║   ███████╗███████╗██║ ╚═╝ ██║██║                          ║
║   ╚══════╝╚══════╝╚═╝     ╚═╝╚═╝                          ║
║                                                            ║
║      Windows 7-Like Graphical Interface                   ║
║      Lightweight & Beautiful Desktop                      ║
║                                                            ║
╚════════════════════════════════════════════════════════════╝

LOGO

echo -e "${LIGHT_BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${YELLOW}            START MENU - Applications & Tools${RESET}"
echo -e "${LIGHT_BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
echo -e "${WHITE}  1)${RESET}  📁 File Manager          - Browse & manage files"
echo -e "${WHITE}  2)${RESET}  📝 Text Editor           - Create & edit documents"
echo -e "${WHITE}  3)${RESET}  💻 Terminal Shell        - Command line access"
echo -e "${WHITE}  4)${RESET}  ⚙️  System Settings       - Configure system"
echo -e "${WHITE}  5)${RESET}  🔍 System Information    - View system details"
echo -e "${WHITE}  6)${RESET}  🌐 Network Config        - Network settings"
echo -e "${WHITE}  7)${RESET}  🎨 GUI Desktop (X11)     - Full GUI experience"
echo -e "${WHITE}  8)${RESET}  💡 Help & Documentation  - Get help"
echo -e "${WHITE}  9)${RESET}  🔌 Power Off System      - Shutdown safely"
echo -e "${WHITE}  0)${RESET}  🚪 Exit to Shell Prompt  - Advanced mode"
echo ""
echo -e "${LIGHT_BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

read -p "Select an option (0-9): " choice

case $choice in
    1)
        echo -e "${LIGHT_BLUE}Opening File Manager...${RESET}"
        sleep 1
        ls -la /
        echo ""
        read -p "Press Enter to return to menu..."
        ;;
    2)
        echo -e "${LIGHT_BLUE}Opening Text Editor...${RESET}"
        sleep 1
        vi /tmp/document.txt
        ;;
    3)
        echo -e "${LIGHT_BLUE}Opening Terminal Shell...${RESET}"
        sleep 1
        /bin/sh
        ;;
    4)
        echo -e "${LIGHT_BLUE}Opening System Settings...${RESET}"
        sleep 1
        lamp-system
        ;;
    5)
        echo -e "${LIGHT_BLUE}System Information:${RESET}"
        echo ""
        echo "━ System Details ━"
        uname -a
        echo ""
        echo "━ CPU Info ━"
        grep "model name" /proc/cpuinfo | head -1
        echo ""
        echo "━ Memory Usage ━"
        free -h
        echo ""
        echo "━ Disk Usage ━"
        df -h | head -3
        echo ""
        read -p "Press Enter to return to menu..."
        ;;
    6)
        echo -e "${LIGHT_BLUE}Network Configuration...${RESET}"
        sleep 1
        lamp-network
        ;;
    7)
        echo -e "${LIGHT_BLUE}Launching Full GUI Desktop...${RESET}"
        echo "Note: Requires X11 display server with graphics support"
        sleep 2
        bash /root/start-desktop.sh
        ;;
    8)
        echo -e "${LIGHT_BLUE}Help & Documentation${RESET}"
        echo ""
        if [ -f /usr/local/share/doc/lamp-os/help.txt ]; then
            cat /usr/local/share/doc/lamp-os/help.txt | head -50
        else
            echo "📚 LAMP OS Help System"
            echo ""
            echo "Quick Commands:"
            echo "  ls - List files"
            echo "  cd - Change directory"
            echo "  cp - Copy files"
            echo "  vi - Text editor"
            echo "  ifconfig - Network info"
            echo "  ps - Process list"
            echo ""
        fi
        echo ""
        read -p "Press Enter to return to menu..."
        ;;
    9)
        echo -e "${LIGHT_BLUE}Shutting Down System...${RESET}"
        echo "Saving data and closing services..."
        sleep 2
        sync
        poweroff
        ;;
    0)
        echo -e "${LIGHT_BLUE}Entering Shell Prompt Mode...${RESET}"
        echo "Type 'exit' to return to menu"
        echo ""
        /bin/sh
        ;;
    *)
        echo -e "${YELLOW}❌ Invalid option! Please select 0-9${RESET}"
        sleep 2
        ;;
esac

# Recursive call for menu loop
exec bash /usr/local/bin/lamp-desktop-menu
