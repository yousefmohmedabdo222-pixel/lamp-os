#!/bin/sh
# LAMP OS Boot Manager Configuration

# Mount basic filesystems
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mount -t tmpfs tmpfs /dev
::sysinit:/bin/mount -t tmpfs tmpfs /tmp

# Create device nodes
::sysinit:/bin/mknod -m 600 /dev/console c 5 1
::sysinit:/bin/mknod -m 666 /dev/null c 1 3
::sysinit:/bin/mknod -m 666 /dev/zero c 1 5
::sysinit:/bin/mknod -m 666 /dev/ttyS0 c 4 64
::sysinit:/bin/mknod -m 666 /dev/tty c 5 0

# Launch LAMP OS Boot Manager (handles both Live and Installed modes)
::respawn:/usr/local/bin/boot-manager.sh < /dev/console > /dev/console 2>&1

# Spawn interactive shell on serial for debugging
::respawn:/bin/sh < /dev/ttyS0 > /dev/ttyS0 2>&1

# Ctrl-Alt-Del handler
::ctrlaltdel:/bin/umount -a -r

